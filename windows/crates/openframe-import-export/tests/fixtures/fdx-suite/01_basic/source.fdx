<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading"><SceneProperties Length="1/8" Page="1" Title=""/><Text>INT. SIGNAL BOX - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>A single lamp. ASHA (40s) watches the rails.</Text></Paragraph>
<Paragraph Type="Character"><Text>ASHA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>The last train is late again.</Text></Paragraph>
<Paragraph Type="Scene Heading"><SceneProperties Length="1/8" Page="1" Title=""/><Text>EXT. PLATFORM - CONTINUOUS</Text></Paragraph>
<Paragraph Type="Action"><Text>Rain on the tin roof.</Text></Paragraph>
<Paragraph Type="Character"><Text>RAVI</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>It always is.</Text></Paragraph>
<Paragraph Type="Transition"><Text>CUT TO:</Text></Paragraph>
<Paragraph Type="Scene Heading"><SceneProperties Length="1/8" Page="1" Title=""/><Text>INT. WAITING ROOM - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>Empty benches. A clock ticks.</Text></Paragraph>
</Content>
</FinalDraft>
