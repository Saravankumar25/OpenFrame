<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
  <Content>
    <Paragraph Type="Scene Heading"><Text>INT. ARJUN&apos;S HOUSE - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>Arjun packs a small bag. A photograph of Ravi leans against the mirror.</Text></Paragraph>
    <Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text>(quietly)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Ten years is a long time to be gone.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. STREET - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>The rain has stopped. Puddles hold the neon of a closed pharmacy.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. LEVEL CROSSING - DAWN</Text></Paragraph>
    <Paragraph Type="Action"><Text>A freight train rolls past. Maya waits behind the barrier with a red umbrella.</Text></Paragraph>
    <Paragraph Type="Character"><Text>MAYA</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>You are late, Arjun.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. OLD RAILWAY STATION - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>Arjun walks the empty platform. A clock above him has stopped at 4:10.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. POLICE STATION - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Arjun enters carrying a pistol. Rain drips from his coat.</Text></Paragraph>
    <Paragraph Type="Action"><Text>He places the RED FOLDER on the desk.</Text></Paragraph>
    <Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>You said you would never come back.</Text></Paragraph>
    <Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text>(quietly)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Neither did the folder.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. OLD RAILWAY STATION - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Ravi crosses the tracks and does not look back.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. MORGUE - MORNING</Text></Paragraph>
    <Paragraph Type="Action"><Text>Meera reads a tag on a cold steel drawer.</Text></Paragraph>
    <Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Same hands. Same knot.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. RAVI&apos;S HOUSE - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Ravi lights one candle. The power is out across the street.</Text></Paragraph>
    <Paragraph Type="Character"><Text>RAVI</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Dad? Is that you?</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. HOSPITAL - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>An ambulance backs into the bay. Maya runs beside the stretcher.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. HOSPITAL CORRIDOR - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Arjun sits alone under a flickering tube light.</Text></Paragraph>
    <Paragraph Type="Character"><Text>MAYA</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>He is asking for you.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. STREET - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Rain again. Meera follows a red motorcycle at a distance.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. POLICE STATION - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>Meera pins a photograph to the board. The RED FOLDER is open in front of her.</Text></Paragraph>
    <Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
    <Paragraph Type="Parenthetical"><Text>(to herself)</Text></Paragraph>
    <Paragraph Type="Dialogue"><Text>Where is the last page?</Text></Paragraph>
  </Content>
  <TitlePage>
    <Content>
      <Paragraph Alignment="Center" Type="Action"><Text>BLACK RAIN</Text></Paragraph>
    </Content>
  </TitlePage>
</FinalDraft>
