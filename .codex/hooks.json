            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" 'C:\\OpenFrame\\.codex\\hooks\\gsd-phase-boundary.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" 'C:\\OpenFrame\\.codex\\hooks\\gsd-check-update.js'"
