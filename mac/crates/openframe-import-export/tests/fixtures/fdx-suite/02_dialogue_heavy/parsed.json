        {
          "custom": null,
          "dual": false,
          "kind": "character",
          "revision": null,
          "text": "ARJUN"
        },
        {
          "custom": null,
          "dual": false,
          "kind": "dialogue",
          "revision": null,
          "text": "Does it matter?"
