          "text": "MEERA"
        },
        {
          "custom": null,
          "dual": false,
          "kind": "dialogue",
          "revision": null,
          "text": "You said you would call."
        },
        {
          "custom": null,
          "dual": false,
          "kind": "character",
          "revision": null,
          "text": "ARJUN"
        },
        {
          "custom": null,
          "dual": false,
          "kind": "dialogue",
          "revision": null,
          "text": "I did call. Twice."
        },
        {
          "custom": null,
          "dual": false,
