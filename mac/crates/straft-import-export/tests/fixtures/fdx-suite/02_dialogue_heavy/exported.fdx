<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading"><Text>INT. KITCHEN - NIGHT</Text></Paragraph>
<Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>You said you would call.</Text></Paragraph>
<Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>I did call. Twice.</Text></Paragraph>
<Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>From whose phone?</Text></Paragraph>
<Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Does it matter?</Text></Paragraph>
<Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>It matters to me.</Text></Paragraph>
<Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Then it was Ravi&apos;s.</Text></Paragraph>
<Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Ravi has been in Pune since Monday.</Text></Paragraph>
<Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Then I was wrong about the phone, not about calling.</Text></Paragraph>
<Paragraph Type="Character"><Text>MEERA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>You said you would call.</Text></Paragraph>
<Paragraph Type="Character"><Text>ARJUN</Text></Paragraph>
