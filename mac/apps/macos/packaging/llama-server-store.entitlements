<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The AI engine helper (llama-server) inside the store build: it inherits the app's sandbox and
     has no rights of its own (ADR on the Mac AI engine form). Its 127.0.0.1 socket uses the
     app's network.server right. A helper with inherit may carry no other key. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key><true/>
	<key>com.apple.security.inherit</key><true/>
</dict>
</plist>
