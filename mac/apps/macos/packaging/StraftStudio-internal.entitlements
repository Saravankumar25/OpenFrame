<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Internal disk image: hardened runtime with one exception. No sandbox (that is the store
     build) and no exception for DYLD environment variables or library validation.
     - device.audio-input: voice notes in the Idea Vault, only while the person records. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
