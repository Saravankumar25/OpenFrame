/target/
/.build-cache/
# Offline AI build inputs (ADR-0025): runtime and model weights, pinned by ai-assets.lock.json,
# too large for git; copied into the app bundle at build time.
/.ai-assets/
node_modules/
apps/desktop/dist/
apps/desktop/src-tauri/gen/
*.log
.DS_Store
Thumbs.db
# Local AI runtime/model downloads used in development
/.dev-models/
/apps/desktop/src-tauri/binaries/*.exe
# Signing material must never be committed
*.pfx
*.p12
*.key
*.pem
.env
.env.*

# Claude Code agent worktrees and local settings
/.claude/

# Desktop E2E: downloaded WebDriver binaries, run data and failure screenshots
/tests/e2e/.drivers/
/tests/e2e/.run/
/tests/e2e/artifacts/

# Local design-hook cache
/.impeccable/

# graphify knowledge graph (local, rebuilt by git hooks)
/graphify-out/

# Fuzzing (Windows phase W3): libFuzzer corpora, crash inputs and coverage stay local.
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/

# Tool and Explorer files that must never be tracked
AGENTS.md
.codex/
desktop.ini
gsd-install.log
.ruff_cache/
