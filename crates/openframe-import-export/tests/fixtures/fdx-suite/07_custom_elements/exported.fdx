<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Type="Scene Heading"><Text>INT. CONTROL ROOM - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>The radio crackles.</Text></Paragraph>
<Paragraph Type="Character"><Text>CONTROL</Text></Paragraph>
<Paragraph Type="TELEPHONE"><Text>this is control. clear the line.</Text></Paragraph>
<Paragraph Type="Lower Third"><Text>Gudur Junction, 2:14 AM</Text></Paragraph>
<Paragraph Type="Action"><Text>ASHA lifts the receiver.</Text></Paragraph>
<Paragraph Type="TELEPHONE"><Text>say again, signal box.</Text></Paragraph>
</Content>
